<?xml version="1.0" encoding="utf-8"?>
<!-- Shared period geometry: two small sp units also follow Android 14 nonlinear font scaling.
     A single 44sp dimension would stop growing while the smaller course text still grows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout android:layout_width="1dp" android:layout_height="@dimen/widget_grid_half_row_h" />
    <LinearLayout android:layout_width="1dp" android:layout_height="@dimen/widget_grid_half_row_h" />
</LinearLayout>
