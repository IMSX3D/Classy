<?xml version="1.0" encoding="utf-8"?>
<!-- 组件预览 · 课程列表（可滚动）（样例内容）。同 widget_preview_today 的说明。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_card"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="周六 9/26 · 3 门课"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#FF000000" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#14000000" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_bar"
            android:backgroundTint="#FFF27B7B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="数据可视化"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="5阶106（中心教学楼）"
                android:textSize="10sp"
                android:textColor="#80000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="第5-8节 · 13:30 - 17:30"
                android:textSize="10sp"
                android:textColor="#80000000" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_bar"
            android:backgroundTint="#FFF58F4B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="软件工程实验"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="多媒体实验室11（综合楼8楼）"
                android:textSize="10sp"
                android:textColor="#80000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="第11-13节 · 20:30 - 21:40"
                android:textSize="10sp"
                android:textColor="#80000000" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_preview_bar"
            android:backgroundTint="#FF7BC8A4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="欧洲古典音乐欣赏"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="人文3-202"
                android:textSize="10sp"
                android:textColor="#80000000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="第9-11节 · 18:30 - 21:05"
                android:textSize="10sp"
                android:textColor="#80000000" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
