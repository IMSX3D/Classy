<?xml version="1.0" encoding="utf-8"?>
<!-- Today widget 静态卡 — 底部导航条·紧凑档 (2×2 等窄档, 2026-09-14 用户定稿):
     「+N」胶囊与翻页钮是并列控件 — 胶囊恒画不被按钮挤掉, 挤就挤一点。
     窄档放不下宽档 (40×24 钮 + 6dp 间距) 时改用本布局: 钮 32×24、零间距、
     内边距 6dp → 导航态 12+36+4+96=148dp 仍容胶囊。子视图限 RemoteViews
     白名单 (禁 View/Space, WidgetLayoutWhitelistTest 锁死)。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_scroll_clip"
    android:outlineProvider="background"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:adjustViewBounds="false"
        android:contentDescription="@string/widget_week_grid_label" />

    <!-- 底部导航条 28dp = TodayRowGeometry.NAV_BAR_H_DP (与宽档同高, 内容预算同扣)。
         胶囊不可点 (纯指示); 三钮 32×24dp 视图即点击区。 -->
    <LinearLayout
        android:id="@+id/widget_today_bar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/widget_nav_more"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:adjustViewBounds="true" />

        <LinearLayout
            android:id="@+id/widget_spacer_l"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_today_nav_prev"
            android:layout_width="32dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="@string/today_nav_prev_day" />

        <ImageView
            android:id="@+id/widget_today_nav_today"
            android:layout_width="32dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="@string/today_nav_back_to_today" />

        <ImageView
            android:id="@+id/widget_today_nav_next"
            android:layout_width="32dp"
            android:layout_height="24dp"
            android:clickable="true"
            android:contentDescription="@string/today_nav_next_day" />
    </LinearLayout>
</FrameLayout>
