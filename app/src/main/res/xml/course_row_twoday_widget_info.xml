<?xml version="1.0" encoding="utf-8"?>
<!-- 近日课程（今天 + 明天，可滚动列表，真实行布局）— M1 新增，2026-09-22。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="180dp"
    android:minHeight="140dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_course_list"
    android:previewLayout="@layout/widget_preview_list"
    android:previewImage="@drawable/widget_preview_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_course_row_twoday_description"
    android:widgetFeatures="reconfigurable" />
